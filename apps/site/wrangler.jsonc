{
  // One Worker serves the pages, the agent API and the jobs. See docs/go-live.md, "The stack".
  "name": "shwarm",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": { "directory": "static" },
  "env": {
    "staging": {
      "name": "shwarm-staging",
      "vars": { "ENV": "staging", "SITE_MODE": "holding", "SITE_URL": "https://shwarm-staging.myrakrusemark.workers.dev", "TURNSTILE_SITE_KEY": "1x00000000000000000000AA", "TRIAGE_MODEL": "@cf/cloudflare/clef-flash" },
      "triggers": { "crons": ["* * * * *", "*/5 * * * *"] }, // mail and triage every minute; stats every 5 (jobs/index.ts)
      "d1_databases": [
        { "binding": "DB", "database_name": "shwarm-staging", "database_id": "debfa9a2-1b5f-47ff-b2e9-6e2c397974ad", "migrations_dir": "migrations" }
      ],
      // One-at-a-time writes per shwarm tree (go-live 2.3). SQLite-backed, as the free plan requires.
      "durable_objects": { "bindings": [{ "name": "TREE", "class_name": "ShwarmTree" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShwarmTree"] }],
      // Triage's model (go-live 8.1): Workers AI, Clef-flash unless TRIAGE_MODEL says otherwise ('@cf/cloudflare/clef' is
      // the fallback). Not inherited from the top level, so each env names it; remote so `wrangler dev` reaches it too.
      "ai": { "binding": "AI", "remote": true }
    },
    "production": {
      "name": "shwarm-production",
      "vars": { "ENV": "production", "SITE_MODE": "holding", "SITE_URL": "https://shwarm.org", "TURNSTILE_SITE_KEY": "0x4AAAAAAFRu8ijzk1oyexJx", "TRIAGE_MODEL": "@cf/cloudflare/clef-flash" },
      "triggers": { "crons": ["* * * * *", "*/5 * * * *"] }, // mail and triage every minute; stats every 5 (jobs/index.ts)
      "routes": [
        { "pattern": "shwarm.org", "custom_domain": true },
        { "pattern": "www.shwarm.org", "custom_domain": true }
      ],
      "d1_databases": [
        { "binding": "DB", "database_name": "shwarm-production", "database_id": "a6803669-1bdf-4ed5-833b-400b8037ec02", "migrations_dir": "migrations" }
      ],
      // One-at-a-time writes per shwarm tree (go-live 2.3). SQLite-backed, as the free plan requires.
      "durable_objects": { "bindings": [{ "name": "TREE", "class_name": "ShwarmTree" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShwarmTree"] }],
      // Triage's model (go-live 8.1): Workers AI, Clef-flash unless TRIAGE_MODEL says otherwise ('@cf/cloudflare/clef' is
      // the fallback). Not inherited from the top level, so each env names it; remote so `wrangler dev` reaches it too.
      "ai": { "binding": "AI", "remote": true }
    }
  }
}
