exports[`mapping the launch list > snapshots of a few mapped entries > bot-beats-freedoom 1`] = `
{
  "input": {
    "buildsOn": {
      "license": "MIT",
      "name": "ViZDoom",
      "url": "https://github.com/Farama-Foundation/ViZDoom",
    },
    "check": {
      "author": false,
      "people": {
        "count": 1,
        "human": true,
        "instructions": "watch at least two replays at full speed. flag any wall clipping, god mode or other cheat, and confirm the bot used no map data beyond the allowed buffers by reading its input code.",
      },
      "runs": {
        "command": "python replay.py demos/",
        "count": 1,
        "description": "replays each MAP01-MAP08 demo in vizdoom 1.3 and prints whether the exit was reached and the time",
      },
    },
    "doneWhen": "an open bot finishes freedoom phase 2 maps 1 to 8 from a pistol start on skill 3, using only vizdoom's screen, depth, label and automap buffers, with eight recorded demos that replay to the exit on other people's machines.",
    "kind": "shwarm",
    "slug": "bot-beats-freedoom",
    "tags": [
      "games",
      "ai",
      "doom",
      "benchmarks",
    ],
    "title": "a bot that beats freedoom",
    "what": "people keep saying ai can do almost anything, and a bot that plays a whole doom level is a simple, public way to check. it's also fun to watch. in the 2025 videogamebench test, the best ai models barely got out of the first room of doom ii. vizdoom lets a bot see the screen plus a few helper views like a depth map. build an open bot that finds the keys in real freedoom levels and reaches the exit alive, so anyone can rerun it and see where game-playing ai really stands.

why now: vizdoom 1.3.1 shipped in september 2026, and full single-player doom levels with keys and switches are still a hard target for bots.",
  },
  "notes": [
    {
      "field": "what",
      "kind": "changed",
      "text": "why_now appended as a last paragraph, "why now: vizdoom 1.3.1 shipped in september 2026…"",
    },
    {
      "field": "check.runs",
      "kind": "changed",
      "text": "command split: "python replay.py demos/", and the words in brackets went to runs.description: "replays each MAP01-MAP08 demo in vizdoom 1.3 and prints whether the exit was reached and the time"",
    },
    {
      "field": "builds_on",
      "kind": "normalized",
      "text": "license "mit" → MIT",
    },
    {
      "field": "license",
      "kind": "changed",
      "text": "MIT, taken from ViZDoom (builds on takes the upstream license)",
    },
    {
      "field": "builds_on",
      "kind": "dropped",
      "text": "words not in {name, url, license}: "which bundles freedoom2.wad"",
    },
    {
      "field": "pinned post",
      "kind": "changed",
      "text": "3 sources, plus the builds-on text as written",
    },
  ],
  "pinned": "where this pitch comes from:
https://github.com/Farama-Foundation/ViZDoom
https://arxiv.org/abs/2505.18134
https://decrypt.co/315493/ai-bad-playing-doom

builds on: ViZDoom (mit) https://github.com/Farama-Foundation/ViZDoom, which bundles freedoom2.wad",
}
`;

