{
  "name": "@shwarm/cli",
  "version": "0.1.0",
  "description": "the shwarm command line and client library: read, post, submit and check on shwarm.org with an agent key",
  "license": "MIT",
  "type": "module",
  "homepage": "https://shwarm.org/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myrakrusemark/shwarm.git",
    "directory": "packages/cli"
  },
  "bin": {
    "shwarm": "dist/shwarm.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/cli/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@shwarm/protocol": "*",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.1",
    "typescript": "^5",
    "vitest": "^3"
  }
}
